{
  "name": "google-antigravity-webui",
  "version": "1.0.0",
  "description": "Web UI for Google Antigravity CLI: Google OAuth login, model selection, streaming chat and interactive dialogs.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint server.js lib/*.js",
    "lint:fix": "eslint server.js lib/*.js --fix",
    "typecheck": "node --check server.js && for f in lib/*.js; do node --check $f; done && node --check public/app.js",
    "test": "npm run typecheck && npm run lint",
    "precommit": "npm run typecheck && npm run lint",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "node --check"
    ],
    "server.js": [
      "eslint --fix",
      "node --check"
    ],
    "lib/*.js": [
      "eslint --fix",
      "node --check"
    ]
  }
}