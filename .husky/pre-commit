#!/bin/bash
set -e
echo "🔍 Running pre-commit checks..."
echo "  1. node --check (syntax)"
node --check server.js
echo "  ✅ server.js"
for f in lib/*.js; do
  node --check "$f"
  echo "  ✅ $f"
done
node --check public/app.js
echo "  ✅ app.js"
echo ""
echo "  2. eslint"
npx eslint server.js lib/*.js 2>&1 | tail -3
echo ""
echo "✅ pre-commit 全部通过"
